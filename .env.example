# All variables are optional. Without them the app runs in fully-offline
# "local mode": no accounts, all data on-device, every feature except
# cross-device sync. This is also what CI/e2e runs against.

# Clerk (https://dashboard.clerk.com → API keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase (https://supabase.com/dashboard → project settings → API).
# Requires the Clerk third-party-auth integration to be enabled on the
# Supabase project so RLS can key off auth.jwt()->>'sub'.
# Apply supabase/migrations/0001_init.sql, then supabase/seed.sql.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
